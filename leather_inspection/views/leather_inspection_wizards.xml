<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="leather_inspection_assign_wizard_view_form" model="ir.ui.view">
        <field name="name">leather.inspection.assign.wizard.form</field>
        <field name="model">leather.inspection.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign" class="o_kroy_wizard">
                <group>
                    <field name="inspection_id"/>
                    <field name="allowed_user_ids" invisible="1"/>
                    <field name="user_id" widget="many2one_avatar_user"/>
                </group>
                <footer>
                    <button name="action_assign" type="object" string="Assign" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="leather_inspection_return_wizard_view_form" model="ir.ui.view">
        <field name="name">leather.inspection.return.wizard.form</field>
        <field name="model">leather.inspection.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return for Correction" class="o_kroy_wizard">
                <group>
                    <field name="inspection_id"/>
                    <field name="reason" placeholder="What needs to be corrected?"/>
                </group>
                <footer>
                    <button name="action_return" type="object" string="Return for Correction" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
