<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Fifteen synthetic SKUs. Hides are lot-tracked units. Area in m² is an inspection measurement, not the stock quantity. -->
    <record id="product_hide_calfskin" model="product.template">
        <field name="name">Calfskin hide</field>
        <field name="default_code">HIDE-CALF</field>
        <field name="type">consu</field>
        <field name="is_storable" eval="True"/>
        <field name="tracking">lot</field>
        <field name="uom_id" ref="uom.product_uom_unit"/>
        <field name="categ_id" ref="product.product_category_goods"/>
    </record>
